# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
.venv-ppcon/

# Jupyter
.ipynb_checkpoints/

# editor
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------
# Paper: Overleaf is the source of truth, never version-controlled here
# ---------------------------------------------------------------
paper/

# ---------------------------------------------------------------
# Checkpoints. Not tracked by default; results/ is re-included below.
# ---------------------------------------------------------------
*.pt
*.pth
*.ckpt

# ---------------------------------------------------------------
# archive/ holds the full run trees, superseded run batches, and strays
# collected from the home directory. Every checkpoint the manuscript cites
# has been copied into results/ and IS tracked; what remains in archive/ is
# redundant final.pt files, intermediate epoch snapshots, and runs that fed
# no table. See archive/README.md.
# ---------------------------------------------------------------
archive/

# ---------------------------------------------------------------
# Re-included: results/ holds every checkpoint behind every table --
# one per model x variable x seed, plus PPCon's released checkpoint.
# ---------------------------------------------------------------
!results/**/*.pt
